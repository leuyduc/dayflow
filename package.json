{
  "name": "dayflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @dayflow/web",
    "dev:api": "npm run dev -w @dayflow/api",
    "build": "npm run build -w @dayflow/domain && npm run build -w @dayflow/contracts && npm run build -w @dayflow/api && npm run build -w @dayflow/web",
    "typecheck": "npm run build -w @dayflow/domain && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format:check": "prettier \"apps/**/*.{ts,tsx,css,json,html}\" \"packages/**/*.{ts,tsx,json}\" \"*.{js,json}\" \"scripts/**/*.mjs\" --check",
    "format": "prettier \"apps/**/*.{ts,tsx,css,json,html}\" \"packages/**/*.{ts,tsx,json}\" \"*.{js,json}\" \"scripts/**/*.mjs\" --write",
    "test": "vitest run",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:preview:allowed-hosts": "node scripts/test-vite-preview-hosts.mjs",
    "db:generate": "drizzle-kit generate --config apps/api/drizzle.config.ts",
    "db:migrate:dev": "npm run db:migrate:dev -w @dayflow/api",
    "db:bootstrap:dev": "npm run db:bootstrap:dev -w @dayflow/api",
    "test:postgres:local": "node scripts/test-g3-postgres.mjs",
    "test:postgres:ci": "node scripts/test-g3-postgres.mjs",
    "test:browser:g4": "node scripts/browser-g4-smoke.mjs",
    "test:browser:g4:postgres": "node scripts/browser-g4-postgres-e2e.mjs",
    "test:browser:g6g8:postgres:local": "node scripts/test-g6-g8-postgres-local.mjs",
    "test:browser:g7:postgres:local": "node scripts/test-g6-g8-postgres-local.mjs g7",
    "test:browser:g7:pwa": "node scripts/browser-g7-pwa-e2e.mjs",
    "test:browser:g7:pwa:local": "node scripts/browser-g7-pwa-e2e.mjs",
    "demo:local": "npm run build && node scripts/start-local-preview.mjs",
    "demo:smoke": "npm run build && node scripts/start-local-preview.mjs --smoke",
    "demo:package": "npm run build && node scripts/package-local-preview.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@testing-library/react": "^16.3.3",
    "eslint": "^9.20.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.64.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.23.0",
    "vitest": "^3.0.0"
  }
}
