{
  "name": "dayflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:web": "npm run dev -w @dayflow/web",
    "dev:api": "npm run dev -w @dayflow/api",
    "build": "npm run build -w @dayflow/domain && npm run build -w @dayflow/contracts && npm run build -w @dayflow/api && npm run build -w @dayflow/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.23.0",
    "vitest": "^3.0.0"
  }
}
