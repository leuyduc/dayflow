# Development example only. Do not commit real secrets or share credential values.
NODE_ENV=development
DAYFLOW_API_HOST=127.0.0.1
DAYFLOW_API_PORT=3002
DAYFLOW_APP_ORIGIN=http://127.0.0.1:5173
DAYFLOW_DB_ENV=development
DATABASE_URL=postgres://dayflow_dev:REPLACE_LOCALLY@127.0.0.1:5432/dayflow_dev
DAYFLOW_CSRF_SECRET=REPLACE_WITH_A_SECURE_RANDOM_SECRET_AT_LEAST_32_BYTES
# Only for first, manually supervised owner bootstrap:
# DAYFLOW_BOOTSTRAP_CONFIRM=YES
# DAYFLOW_OWNER_EMAIL=owner@example.test
# DAYFLOW_OWNER_PASSWORD=SET_OUTSIDE_FILES_VIA_SECURE_INTERACTIVE_ENV
